      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// Get the raw HTML output from the first n8n node\nlet htmlString = $input.first().json.output;\n\n// Ensure it's a string\nif (typeof htmlString !== 'string') htmlString = String(htmlString);\n\n// Remove leading '''html or variations (case-insensitive, optional spaces/newlines)\nhtmlString = htmlString.replace(/^\\s*'''html\\s*/i, '');\n\n// Remove trailing ''' and any extra whitespace/newlines\nhtmlString = htmlString.replace(/\\s*'''\\s*$/g, '');\n\n// Trim any remaining extra spaces or newlines\nhtmlString = htmlString.trim();\n\n// Return in proper n8n format\nreturn [\n  {\n    json: {\n      html: htmlString\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
